aws_region   = "ap-south-1"
project_name = "secure-n-tier-infra"
environment  = "dev"

vpc_cidr = "10.0.0.0/16"

availability_zones = [
  "ap-south-1a",
  "ap-south-1b"
]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

private_subnet_cidrs = [
  "10.0.11.0/24",
  "10.0.12.0/24"
]

database_subnet_cidrs = [
  "10.0.21.0/24",
  "10.0.22.0/24"
]

instance_type     = "c7i-flex.large"
min_size          = 2
max_size          = 2
desired_capacity  = 4
app_port          = 3000
health_check_path = "/"

db_name     = "appdb"
db_username = "admin"
db_password = "REPLACE_ME"
db_port     = 3306